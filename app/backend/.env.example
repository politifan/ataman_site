APP_NAME=Atman API
APP_ENV=development
APP_DEBUG=1
CORS_ORIGINS=http://localhost:5173,https://spiritualst.ru
SITE_URL=https://spiritualst.ru

# Local DB file (SQLite)
DATABASE_URL=sqlite:///./data/site.db

# Media folder mapping
MEDIA_ROOT=../../media_assets

# Legacy YooKassa settings. New service bookings use manual card transfers.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://spiritualst.ru/payment-callback.php
YOOKASSA_WEBHOOK_SECRET=

# Telegram notifications: bookings, contact messages and certificate requests
TELEGRAM_NOTIFICATIONS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Optional HTTP/HTTPS proxy for Telegram API, for example:
# TELEGRAM_PROXY_URL=http://user:password@proxy.example.com:8080
TELEGRAM_PROXY_URL=
# Random secret used by Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=change_me_random_webhook_secret

# Manual card transfer details shown after a booking.
# Use underscores instead of spaces. The app converts underscores back to spaces.
MANUAL_PAYMENT_BANK=Название_банка
MANUAL_PAYMENT_CARD_NUMBER=
MANUAL_PAYMENT_RECIPIENT=
MANUAL_PAYMENT_INSTRUCTIONS=Переведите_точную_сумму_и_нажмите_кнопку_Я_перевёл._Администратор_проверит_поступление.

# Admin auth
ADMIN_JWT_SECRET=change_me_super_secret
ADMIN_ACCESS_TTL_MINUTES=720
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change_me_now
ADMIN_BOOTSTRAP_ROLE=admin

# Legacy fallback token (optional; can be left empty)
ADMIN_TOKEN=
